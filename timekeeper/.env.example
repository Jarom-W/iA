# Credentials stay on the server. Use configure.py to generate this file.
TIME_SECRET_KEY=
ADMIN_USERNAME=jarom
ADMIN_PASSWORD_HASH=
TIME_ORIGIN=https://time.inflectionarchitectures.com
TIME_DATABASE_PATH=/data/timekeeper.sqlite3
TIME_TIMEZONE=America/Denver
TIME_CURRENCY=USD

# Explicit migration switch; never silently fall back to passwords in OIDC mode.
AUTH_MODE=legacy
OIDC_ISSUER=https://auth.inflectionarchitectures.com/realms/inflection
OIDC_CLIENT_ID=ia-time
OIDC_CLIENT_SECRET=
