# Copy to .env on the server. Never commit real credentials.
SECRET_KEY=
ADMIN_USERNAME=jarom
ADMIN_PASSWORD_HASH=
ADMIN_ORIGIN=https://admin.inflectionarchitectures.com
FEEDBACK_ORIGIN=https://feedback.inflectionarchitectures.com
PUBLIC_SITE_ORIGIN=https://inflectionarchitectures.com
DATABASE_PATH=/data/feedback.sqlite3
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=Inflection Architectures <jarom@inflectionarchitectures.com>
SMTP_TLS=ssl

# Optional authenticated ntfy alerts; leave URL/topic empty to disable enqueueing.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# Explicit migration switch; never silently fall back to passwords in OIDC mode.
AUTH_MODE=legacy
OIDC_ISSUER=https://auth.inflectionarchitectures.com/realms/inflection
OIDC_CLIENT_ID=ia-admin
OIDC_CLIENT_SECRET=
